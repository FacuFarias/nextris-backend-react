# True for development, False for production
DEBUG=True

# Flask ENV
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=YOUR_SUPER_KEY

# Database Configuration
DB_USER=your_db_user
DB_PASS=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pacsdb

# Server Configuration
IPSERVER=localhost
BASE_FOLDER=/app/output_pdfs

# DICOM Viewer URL
DICOM_VIEWER_URL=https://viewer.nextris.cloud/viewer

# Keycloak Configuration for DICOM Viewer Authentication
KEYCLOAK_SERVER_URL=https://your-keycloak-server.com/auth
KEYCLOAK_REALM=your-realm
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret
KEYCLOAK_VIEWER_USER=nextrisviewer
KEYCLOAK_VIEWER_PASSWORD=viewer
