DEBUG=True

FLASK_APP=run.py
FLASK_DEBUG=1

ASSETS_ROOT=/static/assets

# Para desarrollo sin PostgreSQL, desactiva DB_ENGINE
DB_ENGINE=postgresql
DB_USER=pacs
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pacsdb

IPSERVER=localhost
BASE_FOLDER=/app/output_pdfs

SECRET_KEY=
DICOM_VIEWER_URL=https://viewer.nextris.cloud/

# Analytics
ANALYTICS_ENABLED=True
ANALYTICS_STORE_IP=True
ANALYTICS_GEO_LOOKUP=TrueANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=

# SMTP default (Resend)
SMTP_SERVER=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_USE_TLS=true
SMTP_FROM=no-reply@nextris.cloud
SMTP_FROM_NAME=NextRIS
# Password can be set either with SMTP_PASSWORD or RESEND_API_KEY.
# Recommended: set only RESEND_API_KEY and keep SMTP_PASSWORD empty.
RESEND_API_KEY=

