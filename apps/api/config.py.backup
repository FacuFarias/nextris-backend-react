@api_blueprint.route('/config/facilities/<facility_id>/whatsapp', methods=['POST'])
@jwt_required()
def create_facility_whatsapp_config(facility_id):
    """
    Crea la configuración de WhatsApp API para una facility
    
    Body JSON:
    {
        "api_url": "string" (required),
        "api_token": "string" (required),
        "phone_number_id": "string" (required),
        "business_account_id": "string" (optional),
        "webhook_verify_token": "string" (optional),
        "is_active": boolean (optional, default: true)
    }
    
    Returns:
    {
        "success": true,
        "message": "Configuración de WhatsApp creada",
        "data": {
            "config_id": "uuid"
        }
    }
    """
    try:
        data = request.get_json()
        
        if not data:
            return jsonify({
                'success': False,
                'message': 'Se requiere un cuerpo JSON'
            }), 400
        
        api_url = data.get('api_url')
        api_token = data.get('api_token')
        phone_number_id = data.get('phone_number_id')
        
        if not all([api_url, api_token, phone_number_id]):
            return jsonify({
                'success': False,
                'message': 'api_url, api_token y phone_number_id son requeridos'
            }), 400
        
        business_account_id = data.get('business_account_id', '')
        webhook_verify_token = data.get('webhook_verify_token', '')
        is_active = data.get('is_active', True)
        
        config = get_db_config()
        if not config:
            return jsonify({
                'success': False,
                'message': 'Error de configuración de base de datos'
            }), 500
        
        connection = psycopg2.connect(**config)
        cursor = connection.cursor()
        
        # Verificar que la facility existe
        cursor.execute("SELECT 1 FROM nextris.tbfacility WHERE guid=%s", (facility_id,))
        if not cursor.fetchone():
            cursor.close()
            connection.close()
            return jsonify({
                'success': False,
                'message': 'Facility no encontrada'
            }), 404
        
        new_guid = str(uuid.uuid4())
        
        query = """
            INSERT INTO nextris.facility_whatsapp_config(
                guid, facility_id, api_url, api_token, phone_number_id, 
                business_account_id, webhook_verify_token, is_active
            ) 
            VALUES (%s, %s, %s, %s, %s, %s, %s, %s)
        """
        
        cursor.execute(query, (
            new_guid, facility_id, api_url, api_token, phone_number_id,
            business_account_id, webhook_verify_token, is_active
        ))
        
        connection.commit()
        cursor.close()
        connection.close()
        
        return jsonify({
            'success': True,
            'message': 'Configuración de WhatsApp creada exitosamente',
            'data': {
                'config_id': new_guid
            }
        }), 201
        
    except Exception as e:
        return jsonify({
            'success': False,
            'message': f'Error: {str(e)}'
        }), 500


