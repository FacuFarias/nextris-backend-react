@api_blueprint.route('/config/facilities/<facility_id>/backend', methods=['GET'])
@jwt_required()
def get_facility_backend_config(facility_id):
    """
    Obtiene la configuración de backend de una facility
    
    Returns:
    {
        "success": true,
        "data": {
            "guid": "...",
            "facility_id": "...",
            "db_user": "...",
            "db_password": "...",
            "db_host": "...",
            "db_port": 5432,
            "db_name": "...",
            "base_folder": "...",
            "ipserver": "..."
        }
    }
    """
    try:
        config = get_db_config()
        if not config:
            return jsonify({
                'success': False,
                'message': 'Error de configuración de base de datos'
            }), 500
        
        connection = psycopg2.connect(**config)
        cursor = connection.cursor()
        
        query = """
            SELECT guid, facility_id, db_user, db_password, db_host, 
                   db_port, db_name, base_folder, ipserver
            FROM nextris.facility_backend_config
            WHERE facility_id = %s
        """
        cursor.execute(query, (facility_id,))
