@api_blueprint.route('/config/facilities/<facility_id>/backend', methods=['POST'])
@jwt_required()
def create_facility_backend_config(facility_id):
    """
    Crea la configuración de backend para una facility
    
    Body JSON:
    {
        "db_user": "string" (required),
        "db_password": "string" (required),
        "db_host": "string" (required),
        "db_port": number (required),
        "db_name": "string" (required),
        "base_folder": "string" (optional),
        "ipserver": "string" (optional)
    }
    
    Returns:
    {
        "success": true,
        "message": "Configuración de backend creada",
        "data": {
            "config_id": "uuid"
        }
    }
    """
    try:
        data = request.get_json()
        
        if not data:
            return jsonify({
                'success': False,
                'message': 'Se requiere un cuerpo JSON'
            }), 400
        
        db_user = data.get('db_user')
        db_password = data.get('db_password')
        db_host = data.get('db_host')
        db_port = data.get('db_port')
        db_name = data.get('db_name')
        
        if not all([db_user, db_password, db_host, db_port, db_name]):
            return jsonify({
                'success': False,
                'message': 'db_user, db_password, db_host, db_port y db_name son requeridos'
            }), 400
        
        base_folder = data.get('base_folder', '')
        ipserver = data.get('ipserver', '')
        
        config = get_db_config()
        if not config:
            return jsonify({
                'success': False,
                'message': 'Error de configuración de base de datos'
            }), 500
        
        connection = psycopg2.connect(**config)
        cursor = connection.cursor()
        
        # Verificar que la facility existe
        cursor.execute("SELECT 1 FROM nextris.tbfacility WHERE guid=%s", (facility_id,))
        if not cursor.fetchone():
            cursor.close()
            connection.close()
            return jsonify({
                'success': False,
                'message': 'Facility no encontrada'
            }), 404
        
        new_guid = str(uuid.uuid4())
        
        query = """
            INSERT INTO nextris.facility_backend_config(
                guid, facility_id, db_user, db_password, db_host, 
                db_port, db_name, base_folder, ipserver
            ) 
            VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s)
        """
        
        cursor.execute(query, (
            new_guid, facility_id, db_user, db_password, db_host,
            db_port, db_name, base_folder, ipserver
        ))
        
        connection.commit()
        cursor.close()
        connection.close()
        
        return jsonify({
            'success': True,
            'message': 'Configuración de backend creada exitosamente',
            'data': {
                'config_id': new_guid
            }
        }), 201
        
    except Exception as e:
        return jsonify({
            'success': False,
            'message': f'Error: {str(e)}'
        }), 500


@api_blueprint.route('/config/facilities/<facility_id>/backend', methods=['PUT', 'PATCH'])
@jwt_required()
def update_facility_backend_config(facility_id):
    """
    Actualiza la configuración de backend de una facility
    
    Body JSON (todos opcionales):
    {
        "db_user": "string",
        "db_password": "string",
        "db_host": "string",
        "db_port": number,
        "db_name": "string",
        "base_folder": "string",
        "ipserver": "string"
    }
    
    Returns:
    {
        "success": true,
        "message": "Configuración de backend actualizada"
    }
    """
    try:
        data = request.get_json()
        
        if not data:
            return jsonify({
                'success': False,
                'message': 'Se requiere un cuerpo JSON'
            }), 400
        
        config = get_db_config()
        if not config:
            return jsonify({
                'success': False,
                'message': 'Error de configuración de base de datos'
            }), 500
        
        connection = psycopg2.connect(**config)
        cursor = connection.cursor()
        
        # Verificar que existe
        cursor.execute("SELECT 1 FROM nextris.facility_backend_config WHERE facility_id=%s", (facility_id,))
        if not cursor.fetchone():
            cursor.close()
            connection.close()
            return jsonify({
                'success': False,
                'message': 'Configuración de backend no encontrada'
            }), 404
        
        # Construir query dinámicamente
        updates = []
        params = []
        
        if 'db_user' in data:
            updates.append("db_user = %s")
            params.append(data['db_user'])
        if 'db_password' in data:
            updates.append("db_password = %s")
            params.append(data['db_password'])
        if 'db_host' in data:
            updates.append("db_host = %s")
            params.append(data['db_host'])
        if 'db_port' in data:
            updates.append("db_port = %s")
            params.append(data['db_port'])
        if 'db_name' in data:
            updates.append("db_name = %s")
            params.append(data['db_name'])
        if 'base_folder' in data:
            updates.append("base_folder = %s")
            params.append(data['base_folder'])
        if 'ipserver' in data:
            updates.append("ipserver = %s")
            params.append(data['ipserver'])
        
        if not updates:
            cursor.close()
            connection.close()
            return jsonify({
                'success': False,
                'message': 'No hay campos para actualizar'
            }), 400
        
        params.append(facility_id)
        query = f"UPDATE nextris.facility_backend_config SET {', '.join(updates)} WHERE facility_id = %s"
        
        cursor.execute(query, params)
        connection.commit()
        
        cursor.close()
        connection.close()
        
        return jsonify({
            'success': True,
            'message': 'Configuración de backend actualizada exitosamente'
        }), 200
        
    except Exception as e:
        return jsonify({
            'success': False,
            'message': f'Error: {str(e)}'
        }), 500


