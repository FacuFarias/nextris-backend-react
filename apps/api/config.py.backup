@api_blueprint.route('/config/facilities/<facility_id>/smtp', methods=['POST'])
@jwt_required()
def create_facility_smtp_config(facility_id):
    """
    Crea la configuración SMTP para una facility
    
    Body JSON:
    {
        "smtp_server": "string" (required),
        "smtp_port": number (required),
        "smtp_user": "string" (required),
        "smtp_password": "string" (required),
        "smtp_from": "string" (required),
        "smtp_from_name": "string" (required),
        "use_tls": boolean (optional, default: true)
    }
    
    Returns:
    {
        "success": true,
        "message": "Configuración SMTP creada",
        "data": {
            "config_id": "uuid"
        }
    }
    """
    try:
        data = request.get_json()
        
        if not data:
            return jsonify({
                'success': False,
                'message': 'Se requiere un cuerpo JSON'
            }), 400
        
        smtp_server = data.get('smtp_server')
        smtp_port = data.get('smtp_port')
        smtp_user = data.get('smtp_user')
        smtp_password = data.get('smtp_password')
        smtp_from = data.get('smtp_from')
        smtp_from_name = data.get('smtp_from_name')
        
        if not all([smtp_server, smtp_port, smtp_user, smtp_password, smtp_from, smtp_from_name]):
            return jsonify({
                'success': False,
                'message': 'Todos los campos SMTP son requeridos'
            }), 400
        
        use_tls = data.get('use_tls', True)
        
        config = get_db_config()
        if not config:
            return jsonify({
                'success': False,
                'message': 'Error de configuración de base de datos'
            }), 500
        
        connection = psycopg2.connect(**config)
        cursor = connection.cursor()
        
        # Verificar que la facility existe
        cursor.execute("SELECT 1 FROM nextris.tbfacility WHERE guid=%s", (facility_id,))
        if not cursor.fetchone():
            cursor.close()
            connection.close()
            return jsonify({
                'success': False,
                'message': 'Facility no encontrada'
            }), 404
        
        new_guid = str(uuid.uuid4())
        
        query = """
            INSERT INTO nextris.facility_smtp_config(
                guid, facility_id, smtp_server, smtp_port, smtp_user, 
                smtp_password, smtp_from, smtp_from_name, use_tls
            ) 
            VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s)
        """
        
        cursor.execute(query, (
            new_guid, facility_id, smtp_server, smtp_port, smtp_user,
            smtp_password, smtp_from, smtp_from_name, use_tls
        ))
        
        connection.commit()
        cursor.close()
        connection.close()
        
        return jsonify({
            'success': True,
            'message': 'Configuración SMTP creada exitosamente',
            'data': {
                'config_id': new_guid
            }
        }), 201
        
    except Exception as e:
        return jsonify({
            'success': False,
            'message': f'Error: {str(e)}'
        }), 500


