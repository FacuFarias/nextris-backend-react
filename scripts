#!/usr/bin/env python3
# -*- encoding: utf-8 -*-

import sys
import os
sys.path.append(os.path.dirname(os.path.abspath(__file__)))

from apps import create_app, db
from apps.authentication.models import Users
from apps.authentication.util import verify_pass, hash_pass

app = create_app()

def check_users():
    with app.app_context():
        print("=== VERIFICACIÓN DE USUARIOS ===\n")
        
        # Contar usuarios
        user_count = Users.query.count()
        print(f"Total de usuarios en la BD: {user_count}")
        
        if user_count == 0:
            print("❌ No hay usuarios en la base de datos!")
            return
        
        # Mostrar primeros 5 usuarios
        users = Users.query.limit(5).all()
        print("\n--- Usuarios encontrados ---")
        for i, user in enumerate(users, 1):
            print(f"{i}. ID: {user.id}")
            print(f"   Username: {user.username}")
            print(f"   Email: {user.email}")
            print(f"   Password hash: {user.password[:50]}...")
            print()
        
        # Probar credenciales específicas
        test_credentials = [
            ("admin", "admin"),
            ("test", "test"),
            ("user", "password"),
            ("administrador", "admin"),
            ("demo", "demo")
        ]
        
        print("--- Probando credenciales ---")
        for username, password in test_credentials:
            user = Users.query.filter_by(username=username).first()
            if user:
                is_valid = verify_pass(password, user.password)
                print(f"✅ Usuario '{username}' existe - Password válida: {is_valid}")
                if not is_valid:
                    # Intentar otras contraseñas comunes
                    common_passwords = ["123456", "password", "admin123", username]
                    for test_pass in common_passwords:
                        if verify_pass(test_pass, user.password):
                            print(f"   💡 La contraseña correcta es: '{test_pass}'")
                            break
            else:
                print(f"❌ Usuario '{username}' no existe")

def create_test_user():
    with app.app_context():
        # Verificar si ya existe un usuario admin
        admin_user = Users.query.filter_by(username='admin').first()
        if not admin_user:
            print("\n--- Creando usuario de prueba ---")
            admin_user = Users(
                username='admin',
                email='admin@test.com',
                password='admin',  # Se hashea automáticamente en __init__
                user_type='admin'
            )
            db.session.add(admin_user)
            db.session.commit()
            print("✅ Usuario admin creado con contraseña 'admin'")
        else:
            print(f"✅ Usuario admin ya existe (ID: {admin_user.id})")

if __name__ == "__main__":
    check_users()
    
    # Si no hay usuarios, crear uno de prueba
    user_count = 0
    with app.app_context():
        user_count = Users.query.count()
    
    if user_count == 0:
        create_test_user()
        print("\n" + "="*50)
        check_users()