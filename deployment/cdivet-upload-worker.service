[Unit]
Description=CDIVET persistent veterinary DICOM upload worker
After=network-online.target docker.service cdivet-backend.service
Wants=network-online.target

[Service]
Type=simple
User=nextris
Group=nextris
WorkingDirectory=/opt/cdivet/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/cdivet/backend/venv/bin/python deployment/veterinary_upload_worker.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=180
UMask=0077

[Install]
WantedBy=multi-user.target
