[Unit]
Description=CDIVET NextRIS single institution API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=nextris
Group=nextris
WorkingDirectory=/opt/cdivet/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/cdivet/backend/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5002 --timeout 300 --access-logfile - --error-logfile - run:app
Restart=on-failure
RestartSec=5
UMask=0027

[Install]
WantedBy=multi-user.target
